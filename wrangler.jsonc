{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srivinayakachavithi2026",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets Directory for React SPA
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // Cloudflare R2 Bucket for Permanent Photo Uploads & Public Image Serving
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "vinayaka-photos",
      "preview_bucket_name": "vinayaka-photos"
    }
  ],

  // Optional Cloudflare D1 Database Binding (run npx wrangler d1 create vinayaka_db)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinayaka_db",
      "database_id": "vinayaka_db"
    }
  ],

  // Optional Cloudflare KV Namespace for quick key-value metadata storage
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "vinayaka_kv_store",
      "preview_id": "vinayaka_kv_preview"
    }
  ]
}
