{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srivinayakachavithi2026",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets Directory for React SPA
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }

  // NOTE: Cloudflare R2 Bucket binding is temporarily commented out below
  // because R2 is not yet enabled on your Cloudflare account (code 10042).
  // Once you enable R2 in Cloudflare Dashboard (Storage & Databases > R2),
  // uncomment this block to activate permanent R2 storage.
  /*
  ,"r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "vinayaka-photos",
      "preview_bucket_name": "vinayaka-photos"
    }
  ],

  // Cloudflare D1 Database Binding (uncomment after running: npx wrangler d1 create vinayaka_db)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinayaka_db",
      "database_id": "<YOUR-D1-DATABASE-UUID>"
    }
  ],

  // Cloudflare KV Namespace (uncomment after running: npx wrangler kv:namespace create vinayaka_kv_store)
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "<YOUR-KV-NAMESPACE-ID>"
    }
  ]
  */
}
